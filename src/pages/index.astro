---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { featuredProjects } from "../data/projects";
import heroPortrait from "../assets/images/triin.p_2bw.jpg";
import BackToTop from "../components/BackToTop.astro";
---

<Layout
	title="Triim Kurbas | Costume Artist"
	description="Editorial-style portfolio for costume artist Triim Kurbas, featuring film, television, and commercial work."
>
	<main class="page">
		<nav class="nav">
			<a class="brand" href="#home">
				<span>Triim Kurbas</span>
			</a>
			<div class="links">
				<a href="#home">Home</a>
				<a href="#work">Costume work</a>
				<a href="#contact">Contact</a>
			</div>
		</nav>

		<header class="hero" id="home">
			<div class="hero-grid">
				<div class="hero-copy">
					<div class="space-y-3">
						<p class="intro">
							TRIIM KURBAS also known as Triim Peetsalu before 2025 - is a COSTUME DESIGNER working on TV-series, film, commercials and photoshoots.
						</p>
						<p class="intro">
							My background is Estonian Art Academy Jewellery and Production Design. Before costume I was working in jewellery.
						</p>
						<p class="intro">
							Here is a list of my work done for TV and Film
						</p>
					</div>
					<div class="actions mt-4 justify-center">
						<a class="button primary" href="#work">Browse Selected Work</a>
					</div>
				</div>
				<aside class="hero-aside">
					<div class="portrait-card">
						<Image
							class="hero-portrait hero-portrait-optimized"
							src={heroPortrait}
							alt="Portrait of Triim Kurbas"
							width={667}
							formats={["avif", "webp"]}
							sizes="(min-width: 920px) 28rem, 100vw"
							loading="eager"
							decoding="async"
							fetchpriority="high"
						/>
					</div>
				</aside>
			</div>
		</header>

		<section class="section" id="work">
			<div class="section-heading section-heading-wide">
				<div>
					<h2>Costume Work</h2>
				</div>
			</div>

			<div class="project-grid">
				{
					featuredProjects.map((project, index) => (
						<article class:list={["project-card", index % 5 === 0 && "project-card-tall"]}>
							<div class="project-media">
								{
									project.embeds.length > 1 ? (
										<div class="project-video-grid">
											{project.embeds.map((embed, embedIndex) => (
												<iframe
													class="project-video"
													src={embed}
													title={`${project.title} trailer ${embedIndex + 1}`}
													loading="lazy"
													allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
													allowfullscreen
													referrerpolicy="strict-origin-when-cross-origin"
												/>
											))}
										</div>
									) : project.embed ? (
										<iframe
											class="project-video"
											src={project.embed}
											title={`${project.title} trailer`}
											loading="lazy"
											allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
											allowfullscreen
											referrerpolicy="strict-origin-when-cross-origin"
										/>
									) : (
										<div class="project-image fallback" aria-hidden="true">
											<span>{project.title}</span>
										</div>
									)
								}
							</div>

							<div class="project-body">
								<p class="project-kicker project-kicker-body">{project.subtitle}</p>
								<h3>{project.title}</h3>
								<p class="project-meta">{project.meta}</p>
								<dl class="project-details">
									<div>
										<dt>Production</dt>
										<dd>{project.production}</dd>
									</div>
									<div>
										<dt>Position</dt>
										<dd>{project.role}</dd>
									</div>
								</dl>
								<!--
								{
									project.link !== "#" && (
										<a class="project-link" href={project.link} target="_blank" rel="noreferrer">
											Open reference
										</a>
									)
								}
								 -->
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!--
		<section class="section spotlight">
			<div class="spotlight-shell">
				<div class="section-heading section-heading-wide">
					<p class="section-label">Estonian and International TV Commercial projects  2017-2020</p>
				</div>
				<div class="spotlight-grid">
					<div class="spotlight-card">
						<p>
							13 different projects such as: Coca-Cola, SONY, Samsung, Expert, DNA, Elisa Eesti, Eesti Pagar etc.
							With productions: Nafta Films, Get Shot Films, Allfilm Proction
						</p>
					</div>
				</div>
			</div>
		</section>
		-->

		<section class="section contact-section" id="contact">
			<div class="contact-shell">
				<BackToTop />
				<h2>Contact</h2>
					<p class="contact">
						<a href="mailto:triim.kurbas@gmail.com">triim.kurbas@gmail.com</a>
					</p>
					<p class="contact">
						<a href="tel:+37253439902">+372 5343 9902</a>
					</p>
					<p class="contact">Tallinn, Estonia</p>
					<p class="contact ad">Available for productions, collaborations, and creative commissions.</p>

				<!--
				<div class="contact-copy">

				</div>


				<div class="contact-card">

				</div>
				-->
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	const syncHeroViewport = () => {
		const nav = document.querySelector(".nav");
		if (!(nav instanceof HTMLElement)) {
			return;
		}

		document.documentElement.style.setProperty("--nav-height", `${nav.offsetHeight}px`);
	};

	syncHeroViewport();
	window.addEventListener("resize", syncHeroViewport, { passive: true });
</script>

<style is:inline>
	.page {
		width: min(100% - 1.25rem, 44rem);
		margin: 0 auto;
		padding: 0.5rem 0 4rem;
		position: relative;
	}

	.contact {
		font-size: 1.05rem;
		color: var(--text);
	}

	.ad {
		margin-top: 1.25rem;
	}

	.hero {
		position: relative;
		padding-bottom: 3rem;
		min-height: auto;
		display: grid;
		align-content: start;
	}

	.nav {
		position: relative;
		z-index: 20;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100dvw;
		margin-top: 0;
		margin-left: calc(50% - 50dvw);
		margin-right: calc(50% - 50dvw);
		padding: 1rem 0 1.2rem;
		padding-inline: 0.625rem;
		background: transparent;
		backdrop-filter: none;
		box-shadow: none;
	}

	.brand,
	.links a,
	.project-link,
	.text-link,
	.contact-card a {
		text-decoration: none;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		min-height: 4.5rem;
		gap: 0.85rem;
		padding-left: 0.8rem;
		font-family: var(--font-nav);
		color: #111111;
		font-size: 1.8rem;
		font-weight: 500;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.brand-mark {
		width: 2rem;
		height: 2rem;
		display: inline-grid;
		place-items: center;
		border: 1px solid #111111;
		border-radius: 0;
		background: #ffffff;
		color: #111111;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		padding-right: 0.5rem;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 4.5rem;
		line-height: 1;
		color: rgba(17, 17, 17, 0.76);
		font-family: var(--font-nav);
		font-size: 1rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.links a:hover {
		color: #111111;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		align-items: center;
		padding-top: 1.75rem;
	}

	.hero-copy {
		order: 1;
	}

	.hero-aside {
		order: 2;
	}

	.hero-copy {
		max-width: 50rem;
		padding: 0;
	}

	.eyebrow,
	.section-label,
	.panel-label,
	.story-kicker,
	.project-kicker,
	dt {
		margin: 0 0 0.8rem;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	h1,
	h2,
	h3,
	p,
	ul,
	dl {
		margin-top: 0;
	}

	h1 {
		max-width: 11ch;
		margin-bottom: 1.2rem;
		font-size: clamp(4.4rem, 11vw, 8.6rem);
		line-height: 0.88;
		letter-spacing: -0.05em;
	}

	h2 {
		margin-bottom: 1rem;
		font-size: clamp(1.85rem, 9vw, 3.2rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
	}

	h3 {
		margin-bottom: 0.75rem;
		font-size: 1.4rem;
		line-height: 1;
	}

	.project-body h3 {
		font-weight: 500;
	}

	p,
	li,
	dd {
		font-size: 0.98rem;
		line-height: 1.68;
		color: var(--muted);
	}

	.intro {
		max-width: 30rem;
		font-size: 1.05rem;
		color: var(--text);
	}

	.supporting {
		max-width: 34rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding: 0.8rem 1.1rem;
		border-radius: 0;
		border: 1px solid var(--line);
		text-decoration: none;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		transition:
			transform 160ms ease,
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.button:hover,
	.project-link:hover,
	.text-link:hover {
		transform: translateY(-2px);
	}

	.button.primary {
		background: var(--text);
		color: white;
	}

	.button.primary:hover {
		background: rgba(17, 17, 17, 0.03);
		border-color: var(--muted);
	}

	.button.secondary {
		background: rgba(255, 255, 255, 0.78);
		color: #111111;
	}

	.hero-aside {
		padding: 0;
		order: 2;
	}

	.portrait-card {
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		overflow: hidden;
	}

	.hero-portrait {
		display: block;
		width: 100%;
		height: auto;
		max-height: none;
	}

	.portrait-card::before {
		content: none;
	}

	.portrait-copy {
		position: relative;
		z-index: 1;
	}

	.hero-facts {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.8rem;
		padding: 1.4rem 0 0;
		margin: 1.4rem 0 0;
		list-style: none;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
	}

	.hero-facts li {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		color: var(--text);
	}

	.hero-facts span {
		font-family: var(--font-display);
		font-size: 1.8rem;
		line-height: 1;
		color: var(--accent-strong);
	}

	.marquee {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		padding-top: 2rem;
	}

	.marquee span {
		padding: 0.55rem 0.9rem;
		border: 1px solid rgba(0, 0, 0, 0.14);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.66);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted-strong);
	}

	.section {
		padding: 3.5rem 0;
	}

	#work.section {
		padding-top: 8rem;
	}

	.section-heading {
		max-width: 42rem;
		margin-bottom: 1.8rem;
	}

	.section-heading-wide {
		max-width: none;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		align-items: end;
	}

	.section-intro {
		margin-bottom: 0.35rem;
	}

	.story-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.story-card,
	.spotlight-card,
	.contact-card {
		padding: 1.25rem;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 1.4rem;
		background: rgba(255, 255, 255, 0.8);
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.05);
	}

	.contact-section {
		padding-top: 2.75rem;
		border-top: 1px solid rgba(0, 0, 0, 0.12);
	}

	.story-card.large {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(236, 236, 236, 0.8)),
			rgba(255, 255, 255, 0.8);
	}

	.feature-frame {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		padding: 1rem;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 1.5rem;
		background: rgba(255, 255, 255, 0.74);
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.06);
	}

	.feature-copy {
		padding: 1rem;
		display: grid;
		align-content: center;
	}

	.feature-meta,
	.project-meta {
		color: var(--muted-strong);
	}

	.text-link,
	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--accent-strong);
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.project-card {
		display: grid;
		overflow: hidden;
		content-visibility: auto;
		contain-intrinsic-size: 36rem;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 0;
		background: rgba(255, 255, 255, 0.84);
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.06);
	}

	.project-card-tall .project-media {
		min-height: 0;
	}

	.project-media {
		position: relative;
		aspect-ratio: 16 / 9;
		min-height: 0;
		height: auto;
		overflow: hidden;
		background: #111111;
	}

	.project-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		background: #d9d9d9;
		filter: grayscale(1);
	}

	.project-video {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		background: #111111;
	}

	.project-video-grid {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(0, 1fr));
		gap: 0.2rem;
		padding: 0.2rem;
		background: #111111;
	}

	.project-video-grid .project-video {
		position: relative;
		inset: auto;
		width: 100%;
		height: 100%;
	}

	.project-image.fallback {
		display: grid;
		place-items: end start;
		padding: 1.2rem;
		background:
			linear-gradient(180deg, rgba(17, 18, 20, 0.08), rgba(17, 18, 20, 0.78)),
			linear-gradient(135deg, #d9d9d9, #5f5f5f);
		color: #ffffff;
		font-size: 1.15rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-kicker-body {
		margin-bottom: 0.55rem;
	}

	.project-body {
		padding: 1.1rem;
	}

	.project-details {
		display: grid;
		gap: 0.9rem;
		margin: 1.3rem 0 1rem;
	}

	.project-details div {
		padding-top: 0.9rem;
		border-top: 1px solid rgba(0, 0, 0, 0.1);
	}

	dt {
		margin-bottom: 0.32rem;
	}

	dd {
		margin: 0;
	}

	.spotlight-shell {
		width: 100%;
	}

	.spotlight-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	.spotlight-card {
		width: 100%;
	}

	.spotlight-card.muted {
		background: rgba(238, 238, 238, 0.92);
	}

	.contact-shell {
		display: block;
		text-align: center;
	}

	.contact-copy {
		margin: 0 auto 1rem;
		padding-right: 0;
		max-width: 32rem;
	}

	.contact-card {
		display: block;
		min-height: 0;
		width: min(100%, 32rem);
		margin: 0 auto;
		text-align: center;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(233, 233, 233, 0.86)),
			rgba(255, 255, 255, 0.8);
	}

	.contact-card a {
		display: block;
		margin-bottom: 0.45rem;
		line-height: 1.2;
		color: var(--text);
		word-break: break-word;
	}

	.contact-copy p,
	.contact-card p,
	.contact-card a {
		font-size: 1.1rem;
		color: var(--text);
	}

	.contact-card p {
		margin-top: 1.5rem;
	}

	@media (min-width: 700px) {
		.page {
			width: min(100% - 2rem, 84rem);
			padding-top: 0.9rem;
		}

		.hero-grid {
			gap: 2rem;
			padding-top: 2.5rem;
		}

		.button {
			width: auto;
			padding-inline: 1.55rem;
		}

		.nav {
			padding-inline: 1rem;
			padding-bottom: 1.4rem;
		}

		.links {
			gap: 1.1rem;
			padding-right: 1rem;
		}

		.section {
			padding: 4.5rem 0;
		}

		.section-heading {
			margin-bottom: 2.2rem;
		}

		.spotlight-shell {
			width: 100%;
		}
	}

	@media (min-width: 920px) {
		.page {
			padding-top: 0;
		}

		.hero {
			height: calc(100dvh - var(--nav-height, 0px));
			min-height: calc(100dvh - var(--nav-height, 0px));
			padding-bottom: 0;
			overflow: hidden;
		}

		.brand {
			padding-left: 1.35rem;
		}

		.nav {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			padding-top: 1.4rem;
			padding-bottom: 1.9rem;
			padding-inline: 1.5rem;
		}

		.hero-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 2.5rem;
			height: 100%;
			min-height: 100%;
			padding-top: 0;
			align-items: end;
		}

		.hero-aside {
			order: 1;
			display: flex;
			align-items: end;
			justify-content: flex-end;
			height: 100%;
		}

		.hero-copy {
			order: 0;
			align-self: center;
			padding-top: 0;
			padding-bottom: 0;
		}

		.portrait-card {
			height: 100%;
			width: 100%;
		}

		.hero-portrait {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center bottom;
		}

		.intro {
			max-width: 40rem;
			font-size: 1.18rem;
		}


		h2 {
			font-size: clamp(1.9rem, 4vw, 3.8rem);
		}

		h3 {
			font-size: 1.6rem;
		}

		p,
		li,
		dd {
			font-size: 1.02rem;
		}

		.section-heading-wide {
			grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
			gap: 2rem;
		}

		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.2rem;
		}

		.project-card-tall .project-media {
			min-height: 0;
		}

		.project-media {
			min-height: 0;
			height: auto;
		}

		.spotlight-grid {
			grid-template-columns: 1.2fr 1fr;
		}

		.contact-shell {
			display: block;
		}

		.contact-copy {
			padding-right: 0;
		}

		.contact-card {
			min-height: 18rem;
		}
	}

	@media (min-width: 1100px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.story-grid {
			grid-template-columns: 1.15fr 1fr 1fr;
		}

		.feature-frame {
