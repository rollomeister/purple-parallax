---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Triim Kurbas Portfolio",
	description = "A simple portfolio website built with Astro.",
} = Astro.props;
---

<!doctype html>
<html lang="en" style="background-color: #f3f3f3;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="theme-color" content="#f3f3f3" />
		<meta name="color-scheme" content="light" />
		<meta name="supported-color-schemes" content="light" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Pliant:wght@300;400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Raleway:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.jpg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body style="background-color: #f3f3f3;">
		<slot />
	</body>
</html>

<style is:global is:inline>
	:root {
		color-scheme: only light;
		--bg: #f3f3f3;
		--surface: #ffffff;
		--surface-strong: #ebebeb;
		--text: #111111;
		--muted: #505050;
		--muted-strong: #2c2c2c;
		--line: #d4d4d4;
		--accent: #111111;
		--accent-soft: #5e5e5e;
		--accent-strong: #000000;
		--shadow: rgba(0, 0, 0, 0.08);
		--font-nav: "Quicksand", "Segoe UI", sans-serif;
		--font-display: "Pliant", "Segoe UI", sans-serif;
		--font-body: "Raleway", "Segoe UI", sans-serif;
		background-color: #f3f3f3 !important;
		background: #f3f3f3 !important;
	}

	* {
		box-sizing: border-box;
	}

	html {
		color-scheme: only light;
		min-height: 100vh;
		background-color: #f3f3f3 !important;
		background: #f3f3f3 !important;
		overscroll-behavior-y: none;
		scroll-behavior: smooth;
		scrollbar-color: #6a6a6a #111111;
		scrollbar-width: auto;
		overflow-x: clip;
	}

	html::-webkit-scrollbar {
		width: 1rem;
	}

	html::-webkit-scrollbar-track {
		background: #111111;
	}

	html::-webkit-scrollbar-thumb {
		background: #6a6a6a;
		border: 2px solid #111111;
		border-radius: 999px;
	}

	html::-webkit-scrollbar-thumb:hover {
		background: #7a7a7a;
	}

	body {
		position: relative;
		margin: 0;
		min-height: 100vh;
		overflow-x: clip;
		overscroll-behavior-y: none;
		font-family: var(--font-body);
		background-color: #f3f3f3 !important;
		background:
			radial-gradient(
				circle at top left,
				rgba(0, 0, 0, 0.04),
				transparent 26rem
			),
			radial-gradient(
				circle at 85% 18%,
				rgba(0, 0, 0, 0.03),
				transparent 22rem
			),
			var(--bg);
		color: var(--text);
	}

	body::after {
		content: "";
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: #f3f3f3;
	}

	body::before {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(0, 0, 0, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
		background-size: 4.25rem 4.25rem;
		mask-image: radial-gradient(
			circle at center,
			black 35%,
			transparent 85%
		);
		opacity: 0.3;
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 400;
	}
</style>
